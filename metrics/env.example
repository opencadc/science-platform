# Optional template for local tooling that reads a `.env` file (for example
# legacy `docker compose` in this directory). The supported dev contract is
# Kubernetes-first; see `docs/dev-setup.md` and `docs/environment-contracts.md`.
#
# Copy to `.env` under `metrics/` if your workflow expects it.
#
# Nested settings use METRICS_ + __ (see `docs/environment-contracts.md`).

METRICS_CLUSTER_NAME=cluster.example
METRICS_CACHE__KEY_SECRET=replace-with-at-least-32-random-bytes
METRICS_REDIS_URL=redis://redis:6379/0
# Kueue (JSON arrays, not comma-separated strings).
# Kubernetes endpoint/credentials/CA are discovered by kr8s from the in-cluster
# service account or a kubeconfig (ADR-0001); they are not configurable here.
# METRICS_PROVIDERS__KUEUE__CLUSTER_QUEUES='["cq-proton","cq-electron"]'
# METRICS_PROVIDERS__KUEUE__NAMESPACES='["canfar-workloads","canfar-workloads-secondary"]'
# METRICS_PROVIDERS__KUEUE__KUEUE_API_VERSION=kueue.x-k8s.io/v1beta2
# Optional Prometheus/Mimir efficiency source; the server owns all PromQL.
# METRICS_PROVIDERS__PROMQL__BASE_URL=https://prometheus.example.invalid
# METRICS_PROVIDERS__PROMQL__MIMIR_TENANT_ID=canfar
# Optional operator-provided OTLP/HTTP receiver for application telemetry.
# Direct environment configuration must enable the metrics exporter explicitly.
# The Helm chart derives this setting from the configured endpoint.
# METRICS_OTEL__METRICS_ENABLED=true
# METRICS_OTEL__EXPORTER_OTLP_ENDPOINT=http://otel-collector.metrics.svc:4318
