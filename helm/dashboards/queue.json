    {
      "type": "stat",
      "title": "Evictions in range",
      "description": "Workloads killed to make room for others. Every eviction is discarded compute — badput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kueue_evicted_workloads_total[$__range]))\nor vector(0)",
