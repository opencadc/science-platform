{
  "uid": "canfar-queue",
  "title": "CANFAR · Queue & Scheduling",
  "description": "Kueue throughput, wait time, quota saturation, and preemption badput. Label-scheme independent: every series here comes from Kueue itself.",
  "tags": [
    "canfar",
    "kueue",
    "queue",
    "shared"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "preload": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "pluginId": "prometheus",
        "refresh": 1,
        "current": {
          "text": "Mimir",
          "value": "mimir"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "description": "Mimir. Prometheus remains selectable as a fallback."
      },
      {
        "name": "cluster_queue",
        "type": "query",
        "label": "ClusterQueue",
        "description": "Kueue ClusterQueue to scope the dashboard to.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kueue_pending_workloads, cluster_queue)",
        "query": {
          "qryType": 1,
          "query": "label_values(kueue_pending_workloads, cluster_queue)",
          "refId": "cluster_queue-variable-query"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "allowCustomValue": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "CANFAR",
      "tags": [
        "canfar"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "Other CANFAR Science Platform dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "The pulse: is the factory moving?",
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Admission attempts/s",
      "description": "Rate at which Kueue tries to admit workloads. The cluster speedometer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kueue_admission_attempts_total[$__rate_interval]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Admitted workloads",
      "description": "Workloads currently admitted and running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_admitted_active_workloads{cluster_queue=~\"$cluster_queue\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
