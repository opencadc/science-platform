{
  "uid": "canfar-storage",
  "title": "CANFAR \u00b7 Storage",
  "description": "PersistentVolumeClaim inventory and fill for the CANFAR namespaces, plus node block-device throughput and latency.",
  "tags": [
    "canfar",
    "shared",
    "storage"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "preload": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "pluginId": "prometheus",
        "refresh": 1,
        "current": {
          "text": "__CANFAR_DS_NAME__",
          "value": "__CANFAR_DS_UID__"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "description": "Metrics backend the panels query. Seeded at install time from grafanaDashboards.datasourceName; any other Prometheus-type datasource stays selectable here."
      },
      {
        "name": "pvc_namespace",
        "type": "query",
        "label": "Namespace",
        "description": "Namespaces holding PersistentVolumeClaims. Defaults to the namespaces this chart installs into; every namespace with claims is available in the picker.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_persistentvolumeclaim_info, namespace)",
        "query": {
          "qryType": 1,
          "query": "label_values(kube_persistentvolumeclaim_info, namespace)",
          "refId": "pvc_namespace-variable-query"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "__CANFAR_RELEASE_NS__",
            "__CANFAR_WORKLOAD_NS__"
          ],
          "value": [
            "__CANFAR_RELEASE_NS__",
            "__CANFAR_WORKLOAD_NS__"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "allowCustomValue": false
      },
      {
        "name": "pvc",
        "type": "query",
        "label": "PersistentVolumeClaim",
        "description": "",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kubelet_volume_stats_capacity_bytes, persistentvolumeclaim)",
        "query": {
          "qryType": 1,
          "query": "label_values(kubelet_volume_stats_capacity_bytes, persistentvolumeclaim)",
          "refId": "pvc-variable-query"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "allowCustomValue": false
      },
      {
        "name": "device",
        "type": "query",
        "label": "Block device",
        "description": "",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_disk_io_now, device)",
        "query": {
          "qryType": 1,
          "query": "label_values(node_disk_io_now, device)",
          "refId": "device-variable-query"
        },
        "refresh": 2,
        "regex": "/^(sd|vd|nvme|dm-).*/",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "allowCustomValue": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "CANFAR",
      "tags": [
        "canfar"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "Other CANFAR Science Platform dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Persistent volumes",
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Volumes",
      "description": "PersistentVolumeClaims that exist in scope.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_persistentvolumeclaim_info{namespace=~\"$pvc_namespace\"})",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Reporting usage",
      "description": "How many of those have usage metrics. The kubelet only emits volume stats for some volumes, so the rest show capacity but no Used or Fill. A gap here is a measurement gap, not an empty volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kubelet_volume_stats_capacity_bytes{namespace=~\"$pvc_namespace\"})\nor vector(0)",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Provisioned capacity",
      "description": "Sum of requested capacity across every claim in scope, measurable or not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=~\"$pvc_namespace\"})",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Used (measurable only)",
      "description": "Consumed space across only the volumes kubelet reports. Not comparable to provisioned capacity above, which covers every claim.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kubelet_volume_stats_used_bytes{namespace=~\"$pvc_namespace\"})\nor vector(0)",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 5
    },
    {
      "type": "gauge",
      "title": "Aggregate fill",
      "description": "Used over capacity across the volumes kubelet reports. Excludes any volume without usage metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kubelet_volume_stats_used_bytes{namespace=~\"$pvc_namespace\"})\n/ sum(kubelet_volume_stats_capacity_bytes{namespace=~\"$pvc_namespace\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Volume inventory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every PersistentVolumeClaim in scope, whether or not usage can be measured. Capacity comes from the claim itself so it is always present; Used and Fill come from kubelet volume stats, which the kubelet only emits for some volumes \u2014 a blank Used is a measurement gap, not an empty volume. Sorted by capacity.",
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(kube_persistentvolumeclaim_info{namespace=~\"$pvc_namespace\"}, \"key\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "label_join(kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=~\"$pvc_namespace\"}, \"key\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "expr": "label_join(kubelet_volume_stats_used_bytes{namespace=~\"$pvc_namespace\"}, \"key\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        },
        {
          "refId": "D",
          "expr": "label_join(kubelet_volume_stats_used_bytes{namespace=~\"$pvc_namespace\"}\n/ on (namespace, persistentvolumeclaim)\nkube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=~\"$pvc_namespace\"}, \"key\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "key": true,
              "Value #A": true,
              "job": true,
              "instance": true,
              "service": true,
              "endpoint": true,
              "container": true,
              "pod": true,
              "uid": true,
              "volumename": true,
              "namespace 2": true,
              "namespace 3": true,
              "namespace 4": true,
              "persistentvolumeclaim 2": true,
              "persistentvolumeclaim 3": true,
              "persistentvolumeclaim 4": true,
              "prometheus": true,
              "prometheus_replica": true,
              "cluster": true,
              "metrics_path": true,
              "node": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "namespace 1": "Namespace",
              "persistentvolumeclaim": "Volume",
              "persistentvolumeclaim 1": "Volume",
              "storageclass": "Class",
              "Value #B": "Capacity",
              "Value #C": "Used",
              "Value #D": "Fill"
            },
            "indexByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Capacity",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true,
        "sortBy": [
          {
            "displayName": "Capacity",
            "desc": true
          }
        ],
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": [
            "Capacity",
            "Used"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Class"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "noValue",
                "value": "static"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "not measurable"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fill"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "noValue",
                "value": "\u2014"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.75
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 12
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Node block device I/O",
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Volume fill over time",
      "description": "Trend matters more than the instantaneous number: a volume climbing steadily will page someone at 3am.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=~\"$pvc_namespace\", persistentvolumeclaim=~\"$pvc\"})\n/ sum by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=~\"$pvc_namespace\", persistentvolumeclaim=~\"$pvc\"})",
          "legendFormat": "{{persistentvolumeclaim}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "insertNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Read throughput",
      "description": "Bytes read from disk per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{device=~\"$device\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
